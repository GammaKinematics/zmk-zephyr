# Based on stm32u5/Kconfig.series
config SOC_SERIES_STM32U0X
	bool "STM32U0x Series MCU"
	select ARM
	select CPU_CORTEX_M0PLUS        # Changed from M33
	select SOC_FAMILY_STM32
	select CPU_HAS_ARM_MPU          # No TrustZone/SAU for M0+
	select CPU_CORTEX_M_HAS_VTOR
	select CPU_CORTEX_M_HAS_SYSTICK
	select HAS_STM32CUBE
	help
	  Enable support for STM32U0 MCU series
