choice
	prompt "STM32U0x MCU Selection"
	depends on SOC_SERIES_STM32U0X

config SOC_STM32U031XX
	bool "STM32U031XX"

config SOC_STM32U073XX
	bool "STM32U073XX"

config SOC_STM32U083XX
	bool "STM32U083XX"

endchoice

config SOC_SERIES
	default "stm32u0x" if SOC_SERIES_STM32U0X

config SOC
	default "stm32u031xx" if SOC_STM32U031XX
	default "stm32u073xx" if SOC_STM32U073XX
	default "stm32u083xx" if SOC_STM32U083XX
